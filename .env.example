GEMINI_API_KEY=your_gemini_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here
DEFAULT_VOICE_ID=your_voice_id_here       # Set by running: python setup.py
GEMINI_MODEL=gemini-2.0-flash             # gemini-2.0-flash (free) | gemini-2.0-flash-lite | gemini-2.5-pro
WHISPER_MODEL=base                        # tiny | base | small (tiny = fastest on Pi)
GPIO_BUTTON_PIN=17
WAKEWORD_MODEL=hey_jarvis                 # hey_jarvis | path/to/custom_model.tflite
WAKEWORD_THRESHOLD=0.5                    # Detection sensitivity 0.0–1.0
BLUETOOTH_SPEAKER_MAC=XX:XX:XX:XX:XX:XX  # Set by running: python setup.py
