GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash             # gemini-2.0-flash (free) | gemini-2.5-flash | gemini-2.5-pro
KOKORO_VOICE=af_heart                     # af_heart | af_bella | am_adam | am_michael | bf_emma | bm_george
KOKORO_LANG=a                             # a = American English, b = British English
KOKORO_SPEED=1.0                          # 0.5 (slow) to 2.0 (fast)
WHISPER_MODEL=base                        # tiny | base | small (tiny = fastest on Pi)
GPIO_BUTTON_PIN=17
WAKEWORD_MODEL=hey_jarvis                 # hey_jarvis | path/to/custom_model.tflite
WAKEWORD_THRESHOLD=0.5                    # Detection sensitivity 0.0–1.0
BLUETOOTH_SPEAKER_MAC=XX:XX:XX:XX:XX:XX  # Set by running: python setup.py
